# Copy to .env and fill in. Documents the environment the app needs.
# On the EC2 host, set these as real environment variables instead of a file.

# JWT signing secret (HS256). Required — the server fails fast if empty.
# Generate a strong random value for production, e.g.: openssl rand -base64 48
JWT_SECRET=

# Postgres connection string (lib/pq URL or keyword/value DSN).
# Dev default points at the local Docker container on port 5433.
DATABASE_URL=postgres://postgres:secret@localhost:5433/gopgtest?sslmode=disable

# Bootstrap admin, ensured idempotently on startup. Set BOTH or neither.
# signup only creates regular users, so this is how an admin first exists.
BOOTSTRAP_ADMIN_EMAIL=admin@payclone.local
BOOTSTRAP_ADMIN_PASSWORD=
